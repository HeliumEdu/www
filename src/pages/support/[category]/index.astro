---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import BreadcrumbStructuredData from '~/components/common/BreadcrumbStructuredData.astro';

import { SUPPORT_CATEGORIES, CATEGORY_BY_SLUG } from '~/utils/supportCategories';

export async function getStaticPaths() {
  // Per-category article order (slug, without category prefix). Tutorial/intro articles
  // come first, then by commonality, with "help I'm stuck" troubleshooting articles last.
  // Articles not listed fall back to alphabetical after the listed ones.
  const ARTICLE_ORDER: Record<string, string[]> = {
    'getting-started': [
      'getting-the-helium-app-ios-android-and-web',
      'where-to-start-with-helium',
      'what-is-the-new-helium',
    ],
    'calendar-and-schedule': [
      'planner-views-and-changing-your-default',
      'adding-non-academic-events-to-the-planner',
      'customizing-colors-for-planner-display',
      'why-items-arent-showing-on-the-planner',
    ],
    classes: [
      'setting-up-and-managing-classes',
      'class-meeting-schedules',
      'cancelling-class-sessions-and-setting-term-holidays',
    ],
    'grades-and-progress': [
      'understanding-the-grades-dashboard',
      'how-helium-calculates-your-grades',
      'setting-up-weighted-grading-assignment-categories',
      'grade-calculator',
      'why-your-grades-might-not-match-your-lms-or-teachers',
      'why-your-grade-graph-shows-sudden-drops-or-spikes',
    ],
    notebook: ['linked-vs-standalone-notes', 'using-resources-to-track-study-materials'],
    'reminders-and-notifications': [
      'setting-up-and-managing-reminders',
      'reminder-types-push-vs-email-notifications',
      'push-notifications-or-email-reminders-not-working',
    ],
    'sync-and-integration': [
      'how-to-sync-google-apple-or-other-calendars-into-helium-using-external-calendars',
      'how-to-sync-helium-out-to-google-apple-or-other-calendars-using-feeds',
      'how-to-export-data-to-an-icalics-file',
      'using-the-helium-api',
    ],
    'import-export-and-backup': [
      'importing-and-exporting-your-data',
      'what-is-included-in-a-helium-backup-and-what-isnt',
      'printing-and-exporting-to-pdf-or-csv',
      're-importing-the-example-schedule',
    ],
    account: [
      'signing-in-with-google-apple-or-microsoft',
      'changing-the-app-theme-dark-mode',
      'resetting-your-password',
      'deleting-your-account-and-data',
    ],
  };

  const articleSlug = (id: string) => id.split('/').slice(1).join('/');

  const allArticles = await getCollection('support');

  return SUPPORT_CATEGORIES.map((category) => {
    const order = ARTICLE_ORDER[category.slug] ?? [];
    const indexOf = (slug: string) => {
      const i = order.indexOf(slug);
      return i === -1 ? Number.MAX_SAFE_INTEGER : i;
    };

    const articles = allArticles
      .filter((a) => a.data.category === category.slug)
      .sort((a, b) => {
        const ai = indexOf(articleSlug(a.id));
        const bi = indexOf(articleSlug(b.id));
        if (ai !== bi) return ai - bi;
        return a.data.title.localeCompare(b.data.title);
      });

    return {
      params: { category: category.slug },
      props: { category, articles },
    };
  });
}

const { category, articles } = Astro.props;

const metadata = {
  title: `${category.title} — Helium Support`,
  description: category.description,
};

const breadcrumbs = [
  { name: 'Support', path: '/support' },
  { name: category.title, path: `/support/${category.slug}` },
];
---

<Layout metadata={metadata}>
  <BreadcrumbStructuredData items={breadcrumbs} />
  <WidgetWrapper containerClass="max-w-4xl mx-auto py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
      <a href="/support/" class="hover:text-primary">Support</a>
      <span class="mx-2">/</span>
      <span class="text-default dark:text-slate-200">{category.title}</span>
    </nav>

    <div class="flex items-center gap-4 mb-3">
      <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary p-2">
        <Icon name={category.icon} class="w-7 h-7" />
      </div>
      <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter text-heading">
        {category.title}
      </h1>
    </div>
    <p class="text-lg text-muted mb-10">{category.description}</p>

    {
      articles.length === 0 ? (
        <p class="text-muted">No articles in this category yet.</p>
      ) : (
        <ul class="divide-y divide-gray-200 dark:divide-slate-700 border-y border-gray-200 dark:border-slate-700">
          {articles.map((article) => (
            <li>
              <a
                href={`/support/${article.id}`}
                class="group flex items-start justify-between gap-4 py-5 hover:bg-blue-50/40 dark:hover:bg-white/[0.03] -mx-4 px-4 rounded-lg transition-colors"
              >
                <div class="flex-1">
                  <h2 class="text-lg font-bold text-heading dark:text-white group-hover:text-primary transition-colors">
                    {article.data.title}
                  </h2>
                  <p class="text-muted dark:text-slate-400 text-sm mt-1">{article.data.description}</p>
                </div>
                <Icon name="tabler:chevron-right" class="w-5 h-5 text-muted mt-1 shrink-0" />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-10">
      <a href="/support/" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">
        <Icon name="tabler:arrow-left" class="w-4 h-4" />
        Back to support
      </a>
    </div>
  </WidgetWrapper>
</Layout>
