---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import ArticleStructuredData from '~/components/common/ArticleStructuredData.astro';
import BreadcrumbStructuredData from '~/components/common/BreadcrumbStructuredData.astro';

import { CATEGORY_BY_SLUG } from '~/utils/supportCategories';

export async function getStaticPaths() {
  const articles = await getCollection('support');

  return articles.map((article) => {
    const slug = article.id.split('/').slice(1).join('/');
    return {
      params: { category: article.data.category, slug },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);
const category = CATEGORY_BY_SLUG[article.data.category];

const metadata = {
  title: `${article.data.title} — Helium Support`,
  description: article.data.description,
};

const breadcrumbs = [
  { name: 'Support', path: '/support' },
  ...(category ? [{ name: category.title, path: `/support/${category.slug}` }] : []),
  { name: article.data.title, path: `/support/${article.data.category}/${article.id.split('/').slice(1).join('/')}` },
];
---

<Layout metadata={metadata}>
  <ArticleStructuredData article={article} />
  <BreadcrumbStructuredData items={breadcrumbs} />
  <article class="px-4 py-12 sm:px-6 mx-auto lg:px-8 lg:py-16 max-w-4xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
      <a href="/support/" class="hover:text-primary">Support</a>
      <span class="mx-2">/</span>
      {
        category && (
          <>
            <a href={`/support/${category.slug}`} class="hover:text-primary">
              {category.title}
            </a>
            <span class="mx-2">/</span>
          </>
        )
      }
      <span class="text-default dark:text-slate-200">{article.data.title}</span>
    </nav>

    <h1 class="font-bold font-heading text-3xl md:text-4xl lg:text-5xl leading-tighter tracking-tighter text-heading mb-8">
      {article.data.title}
    </h1>

    <div
      data-pagefind-body
      class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg"
    >
      <Content />
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-gray-200 dark:border-slate-700">
      {
        category && (
          <a
            href={`/support/${category.slug}`}
            class="inline-flex items-center gap-1 text-sm text-primary hover:underline"
          >
            <Icon name="tabler:arrow-left" class="w-4 h-4" />
            Back to {category.title}
          </a>
        )
      }
      <a href="/support/" class="inline-flex items-center gap-1 text-sm text-muted hover:text-primary">
        All Support
        <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </article>

  <template id="copy-button-template">
    <button
      type="button"
      aria-label="Copy to clipboard"
      class="ml-3 align-middle text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="w-6 h-6"
        aria-hidden="true"
      >
        <path d="M8 8m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" />
        <path d="M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2" />
      </svg>
    </button>
  </template>
  <template id="copy-button-copied-content">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-6 h-6"
      aria-hidden="true"
    >
      <path d="M5 12l5 5l10 -10" />
    </svg>
  </template>
</Layout>

<script>
  const COPY_LABEL = 'Copy to clipboard';
  const COPIED_LABEL = 'Copied';

  const buttonTemplate = document.getElementById('copy-button-template') as HTMLTemplateElement | null;
  const copiedContentTemplate = document.getElementById('copy-button-copied-content') as HTMLTemplateElement | null;

  const findPrecedingHeading = (pre: HTMLPreElement): HTMLElement | null => {
    let cursor: Element | null = pre.previousElementSibling;
    while (cursor) {
      if (/^H[1-6]$/.test(cursor.tagName)) return cursor as HTMLElement;
      cursor = cursor.previousElementSibling;
    }
    return null;
  };

  if (buttonTemplate && copiedContentTemplate) {
    document.querySelectorAll<HTMLPreElement>('article .prose pre').forEach((pre) => {
      const heading = findPrecedingHeading(pre);
      if (!heading || heading.querySelector('[data-copy-button]')) return;

      const button = buttonTemplate.content.firstElementChild?.cloneNode(true) as HTMLButtonElement | null;
      if (!button) return;
      button.dataset.copyButton = '';

      const originalChildren = Array.from(button.children).map((c) => c.cloneNode(true));
      heading.appendChild(button);

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          const copied = Array.from(copiedContentTemplate.content.children).map((c) => c.cloneNode(true));
          button.replaceChildren(...copied);
          button.setAttribute('aria-label', COPIED_LABEL);
          setTimeout(() => {
            button.replaceChildren(...originalChildren.map((c) => c.cloneNode(true)));
            button.setAttribute('aria-label', COPY_LABEL);
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code block:', err);
        }
      });
    });
  }
</script>
