---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';

import { CATEGORY_BY_SLUG } from '~/utils/supportCategories';

export async function getStaticPaths() {
  const articles = await getCollection('support');

  return articles.map((article) => {
    const slug = article.id.split('/').slice(1).join('/');
    return {
      params: { category: article.data.category, slug },
      props: { article },
    };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);
const category = CATEGORY_BY_SLUG[article.data.category];

const metadata = {
  title: `${article.data.title} — Helium Support`,
  description: article.data.description,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-12 sm:px-6 mx-auto lg:px-8 lg:py-16 max-w-4xl">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
      <a href="/support" class="hover:text-primary">Support</a>
      <span class="mx-2">/</span>
      {
        category && (
          <>
            <a href={`/support/${category.slug}`} class="hover:text-primary">
              {category.title}
            </a>
            <span class="mx-2">/</span>
          </>
        )
      }
      <span class="text-default dark:text-slate-200">{article.data.title}</span>
    </nav>

    <h1 class="font-bold font-heading text-3xl md:text-4xl lg:text-5xl leading-tighter tracking-tighter text-heading mb-8">
      {article.data.title}
    </h1>

    <div
      data-pagefind-body
      class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg"
    >
      <Content />
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-gray-200 dark:border-slate-700">
      {
        category && (
          <a
            href={`/support/${category.slug}`}
            class="inline-flex items-center gap-1 text-sm text-primary hover:underline"
          >
            <Icon name="tabler:arrow-left" class="w-4 h-4" />
            Back to {category.title}
          </a>
        )
      }
      <a href="/support" class="inline-flex items-center gap-1 text-sm text-muted hover:text-primary">
        All Support
        <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</Layout>
