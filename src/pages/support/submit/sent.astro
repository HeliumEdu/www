---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';

import { SUPPORT_EMAIL } from '~/links';

const metadata = {
  title: 'Ticket Submitted — Helium Support',
  description: 'Your support request was submitted.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-2xl mx-auto py-16 md:py-20">
    <div class="text-center">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary mb-6">
        <Icon name="tabler:check" class="w-9 h-9" />
      </div>

      <h1 class="font-bold font-heading text-3xl md:text-4xl leading-tighter tracking-tighter text-heading">
        Ticket submitted
      </h1>
      <p class="mt-4 text-lg text-muted">
        Thanks for reaching out. You'll get a reply at the email address you provided.
      </p>
      <p class="mt-3 text-sm text-muted">
        If you don't hear back, drop a line directly at
        <a href={`mailto:${SUPPORT_EMAIL}`} class="text-primary hover:underline">{SUPPORT_EMAIL}</a>.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button variant="primary" text="Back to Support" href="/support" icon="tabler:arrow-left" />
        <Button variant="secondary" text="Home" href="/" />
      </div>
    </div>
  </WidgetWrapper>
</Layout>
