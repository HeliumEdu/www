---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { SUPPORT } from '~/links';

const title = `Page Not Found`;
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <section class="flex items-center min-h-[60vh] py-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto">
      <div class="max-w-xl text-center">
        <h1 class="mb-4 font-bold text-8xl md:text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-2xl md:text-3xl font-semibold mb-4 dark:text-white">This page is off the syllabus.</p>
        <p class="mb-8 text-lg text-muted dark:text-slate-400">
          Head home, or reach out if you think something's missing.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a rel="noopener noreferrer" href={getHomePermalink()} class="btn-primary">Home</a>
          <a rel="noopener noreferrer" href={SUPPORT} class="btn">Support</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
