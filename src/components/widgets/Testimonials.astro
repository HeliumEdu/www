---
import type { Testimonials as Props } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  testimonials = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-3xl mx-auto',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-2xl mx-auto text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {
      testimonials.map(({ testimonial, name, job, image }) => {
        const imageObj =
          image && typeof image === 'object' && 'src' in image
            ? (image as { src: string; alt?: string })
            : null;
        return (
          <figure class="flex flex-col rounded-2xl border border-blue-100 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
            <Icon name="tabler:quote" class="h-8 w-8 text-primary/40" />
            {testimonial && (
              <blockquote class="mt-4 grow text-lg text-heading dark:text-white leading-relaxed" set:html={testimonial} />
            )}
            <figcaption class="mt-6 flex items-center gap-3 border-t border-blue-100 dark:border-slate-700 pt-4">
              {imageObj ? (
                <img
                  src={imageObj.src}
                  alt={imageObj.alt ?? name ?? ''}
                  class="h-10 w-10 rounded-full object-cover"
                />
              ) : (
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-bold">
                  {name ? name.charAt(0) : '?'}
                </div>
              )}
              <div>
                {name && <div class="font-semibold text-heading dark:text-white">{name}</div>}
                {job && <div class="text-sm text-muted dark:text-slate-400">{job}</div>}
              </div>
            </figcaption>
          </figure>
        );
      })
    }
  </div>
</WidgetWrapper>
