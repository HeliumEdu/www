---
import type { Features as Props } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import Button from '~/components/ui/Button.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  items = [],
  columns = 3,
  defaultIcon,
  callToAction1,
  callToAction2,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-3xl mx-auto',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-2xl mx-auto text-xl text-muted dark:text-slate-400',
    }}
  />
  <ItemGrid
    items={items}
    columns={columns}
    defaultIcon={defaultIcon}
    classes={{
      container: 'gap-x-8 gap-y-10 md:gap-y-12',
      panel: 'max-w-none',
      title: 'text-xl font-bold leading-6 dark:text-white ml-2',
      description: 'text-muted dark:text-slate-400 ml-2 mt-2',
      icon: 'flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary p-2',
    }}
  />
  {
    (callToAction1 || callToAction2) && (
      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-3">
        {callToAction1 && <Button {...callToAction1} />}
        {callToAction2 && <Button {...callToAction2} />}
      </div>
    )
  }
</WidgetWrapper>
